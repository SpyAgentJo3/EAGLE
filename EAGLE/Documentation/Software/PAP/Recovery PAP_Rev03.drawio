        <mxCell id="RmtWR7mwhwHTpIYOywoc-13" value="&lt;div align=&quot;left&quot;&gt;Apogee detection:&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&lt;ul&gt;&lt;li&gt;Change in altitude&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;altitude getting smaller over multiple datasets&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;VelZ == 0&amp;nbsp;&lt;/li&gt;&lt;li&gt;RotationZ &amp;gt; 45&lt;span data-huuid=&quot;8487350613407640495&quot;&gt;&lt;span&gt;°&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
