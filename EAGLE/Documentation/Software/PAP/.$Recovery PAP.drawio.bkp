<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/142.0.0.0 Safari/537.36" version="29.0.3">
  <diagram name="Seite-1" id="iD7n1RVi8xdax-8iwi0D">
    <mxGraphModel dx="1642" dy="1598" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="lRD6Wx8wFjBgip5wHSY7-57" value="Note:&amp;nbsp;&lt;div&gt;- Instead of using array maybe use classes and attributes&lt;div&gt;-&amp;gt; should be more performance optimized&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;--&amp;gt; class: dataset&lt;/div&gt;&lt;div&gt;---&amp;gt; attributes: e.g. dataset.accelerationX1&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- Logging optional depending on uC performance&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- All Status changes should be communicated with telemetry&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- Instead of Booleans use Status byte&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;and check for status byte&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="-140" y="120" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m2oRSrEeqgmuoLIzp4l1-1" value="Statusbyte structure (should be send to telemetry at the beginning of each loop):&lt;div&gt;&lt;ul&gt;&lt;li&gt;1 byte (char)&lt;/li&gt;&lt;li&gt;States:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;0000 0000 (0): Pad Idle&lt;/li&gt;&lt;li&gt;0000 0001 (1): Main deploy setpoint set&lt;/li&gt;&lt;li&gt;0000 0010 (2): Armed&lt;/li&gt;&lt;li&gt;0000 0011 (3): Continuity positive&lt;/li&gt;&lt;li&gt;0000 0100 (4): Liftoff detected&lt;/li&gt;&lt;li&gt;0000 0101 (5): Booster Burnout/Coasting&lt;/li&gt;&lt;li&gt;0000 0110 (6): Apogee detected&lt;/li&gt;&lt;li&gt;0000 0111 (7): Pyro 1 signal sent (drogue)&lt;/li&gt;&lt;li&gt;0000 1000 (8): Pyro2 signal sent (drogue)&lt;/li&gt;&lt;li&gt;0000 1001 (9): Drogue deplyoment detected&lt;/li&gt;&lt;li&gt;0000 1010 (10): Pyro3 signal sent (main&lt;/li&gt;&lt;li&gt;0000 1011 (11): Pryo4 signal sent (main)&lt;/li&gt;&lt;li&gt;0000 1100 (12): Main deployment detected&lt;/li&gt;&lt;li&gt;0000 1101 (13): Landed&lt;/li&gt;&lt;li&gt;0000 1110 (14): ABORT - Failed to initialize&lt;/li&gt;&lt;li&gt;0000 1111 (15): ABORT - No continuity&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="-230" y="360" width="340" height="160" as="geometry" />
        </mxCell>
